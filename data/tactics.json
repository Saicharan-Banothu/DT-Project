  "tactics": [
    {
      "id": "authority_impersonation",
      "title": "Pretending to be an authority",
      "icon": "shield-alert",
      "severity": "high",
      "badge_class": "badge-authority",
      "checklist_label": "Claims to be your bank or official authority",
      "description": "Claims to represent a bank manager, telecom company, police, customs, or court official.",
      "regex": "\\b(bank\\s+manager|sbi\\s+bank|hdfc\\s+bank|icici\\s+bank|axis\\s+bank|state\\s+bank\\s+of\\s+india|jio\\s+customer\\s+care|airtel\\s+customer\\s+care|vodafone\\s+customer|vi\\s+customer|telecom\\s+official|cyber\\s+crime\\s+branch|police\\s+officer|cbi\\s+officer|customs\\s+officer|income\\s+tax\\s+department|rbi\\s+officer|supreme\\s+court|high\\s+court|mha\\s+official|trai\\s+official|customs\\s+department|sharma\\s+speaking\\s+from\\s+sbi|calling\\s+from\\s+head\\s+office|customer\\s+care\\s+executive|branch\\s+manager|nodal\\s+officer|investigating\\s+officer)\\b",
      "hinglish_regex": "\\b(mai\\s+bank\\s+se\\s+bol\\s+raha\\s+hu|sbi\\s+ka\\s+manager\\s+hu|jio\\s+office\\s+se\\s+call\\s+hai|police\\s+thana\\s+se\\s+bol\\s+rahe\\s+hai|cyber\\s+branch\\s+se\\s+phone\\s+hai)\\b",
      "keywords": ["bank manager", "sbi", "hdfc", "police", "customs", "cbi", "cyber crime", "telecom official", "customer care"]
    },
    {
      "id": "urgency_threat",
      "title": "Creating false urgency or pressure",
      "icon": "clock",
      "severity": "high",
      "badge_class": "badge-urgency",
      "checklist_label": "Creating immediate pressure or time limit",
      "description": "Forces quick compliance with strict time limits or threats of immediate service cutoff.",
      "regex": "\\b(in\\s+23\\s+hours|in\\s+2\\s+hours|within\\s+\\d+\\s+hours|immediately|right\\s+now|urgently|sim\\s+will\\s+be\\s+closed|sim\\s+will\\s+be\\s+blocked|account\\s+will\\s+be\\s+blocked|card\\s+is\\s+about\\s+to\\s+expire|last\\s+chance|before\\s+midnight|today\\s+only|final\\s+notice|service\\s+will\\s+be\\s+suspended|electricity\\s+power\\s+cut|action\\s+required\\s+within)\\b",
      "hinglish_regex": "\\b(turant\\s+karna\\s+hoga|aaj\\s+hi\\s+karna\\s+padega|23\\s+ghante\\s+me\\s+sim\\s+band\\s+hoga|account\\s+block\\s+ho\\s+jayega|line\\s+kat\\s+di\\s+jayegi|aakhri\\s+mauka)\\b",
      "keywords": ["immediately", "23 hours", "right now", "blocked", "closed", "final notice", "suspended", "urgently"]
    },
    {
      "id": "secrecy_isolation",
      "title": "Demanding secrecy and isolation",
      "icon": "lock",
      "severity": "critical",
      "badge_class": "badge-secrecy",
      "checklist_label": "Asking you to keep it secret or isolate yourself",
      "description": "Instructs the listener not to disconnect, not to speak to family, or to remain isolated on video.",
      "regex": "\\b(don'?t\\s+tell\\s+anyone|do\\s+not\\s+tell\\s+anyone|stay\\s+on\\s+the\\s+line|do\\s+not\\s+hang\\s+up|don'?t\\s+hang\\s+up|stay\\s+on\\s+video|do\\s+not\\s+speak\\s+to\\s+family|keep\\s+it\\s+strictly\\s+confidential|close\\s+the\\s+door|go\\s+to\\s+a\\s+quiet\\s+room|do\\s+not\\s+share\\s+with\\s+anyone|stay\\s+isolated)\\b",
      "hinglish_regex": "\\b(kisi\\s+ko\\s+mat\\s+batana|ghar\\s+walo\\s+se\\s+baat\\s+mat\\s+karo|phone\\s+mat\\s+katna|line\\s+par\\s+raho|kamra\\s+band\\s+karlo)\\b",
