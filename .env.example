# SentiCall v3 Environment Configuration Template
# Copy this file to .env and configure secrets.
# NEVER commit .env to version control!

# Environment mode: 'development' or 'production'
# In development on localhost, DEV_LOGIN_BYPASS=true can be used.
# In production, the server fails closed if required secrets are missing.
ENV=development

# Public base URL (used for building OAuth redirect URIs and CSRF origin checks)
# In production: https://senticall-v2.onrender.com
# In local dev: http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Credentials (obtain from Google Cloud Console)
# Scopes requested: openid email profile
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server session encryption key (min 32 random characters / 256 bits)
# Generated via: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-this-to-a-secure-random-32-byte-hex-string

# Database URL
# In local dev: sqlite:///./data/senticall_auth.db (stored separately from call data)
# In production: postgresql://user:password@host/dbname (e.g., Neon or Supabase free tier)
DATABASE_URL=sqlite:///./data/senticall_auth.db

# Admin Authorization
# Comma-separated list of emails with admin role (can view /admin/health counts, cannot see call content)
ADMIN_EMAILS=admin@senticall.ai,banothu@dt.edu

# Optional Access Whitelist (leave empty to allow any Google user)
# If set, only these comma-separated emails can sign in during private testing
ALLOWED_EMAILS=

# Development login bypass (ONLY allowed when ENV=development AND host is localhost)
# Server refuses to start if true when ENV=production
DEV_LOGIN_BYPASS=false

# Optional server-side ASR fallback (P2, defaults to false)
ENABLE_SERVER_ASR=false
